# GitHub Pages build-time public configuration. No secret may use VITE_ prefix.
VITE_API_BASE=

# Node 24 community service
HOST=127.0.0.1
PORT=4387
DATA_DIR=runtime
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY=false
# Production requires a persistent random secret, owner password hash and moderation key.
SESSION_SECRET=
ADMIN_PASSWORD_HASH=

# Optional paid AI service. Set a provider-side spending cap as well.
OPENAI_API_KEY=
OPENAI_MODEL=
MODERATION_API_KEY=
DAILY_AI_REQUEST_LIMIT=50

# Scheduled publisher: off until the provider and source checks are configured.
RESEARCH_ENABLED=false
RESEARCH_MODEL=
RESEARCH_REVIEW_MODEL=
RESEARCH_MAX_REPORTS=2
